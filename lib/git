# -*- mode: Shell-script -*-

in-path git || return 0

new-alias git-repo "git repo structure --format=table --progress"
new-alias git-reword "git history reword"

remotes() {
  git remote --verbose "$@" | \
  cut -f1 -d"(" | \
  sort -u | \
  column -t
}

branches() {
  { echo "|Date|Author|Commit|Branch|Upstream|Subject"
    git branch --format="%(HEAD)|%(committerdate:format:%F %T)|%(authorname)|%(objectname:short)|%(refname:short)|%(upstream:short) %(upstream:track)|%(contents:lines=1)" --sort='-committerdate' "$@"
  } | column -t -s"|" -l 7
}
complete -W "--all --remote" branches

[ -d ~git ] && new-alias origin 'cd "$(git remote get-url --push origin)"'

in-path delta && export DELTA_FEATURES=default

is-worktree() {
  git -C "${1:-.}" rev-parse --is-inside-work-tree >/dev/null 2>/dev/null
}
complete -A directory is-worktree

git-changed() (
  local _ref _target _help

  if [[ "$1" =~ ^-+t(arget)?$ && $# -gt 1 ]] ; then
    if [ -d "$2" ] ; then
      _target="$2"
      shift 2
    else
      fn-error "Target \"$2\" does not exist or is not a directory!"
      return 1
    fi
  fi

  if [[ $# -ge 1 && $# -le 2 ]] ; then

    if is-worktree ; then

      export _ref="${2:-HEAD}"
      export _target

      myprofile _fzf

      _changed() {
        git log --since-as-filter="$1" --pretty="" --name-only "$_ref" | sort -u
      }
      _delta() {
        delta | sed -r 's/^[[:space:]]+$//' | cat -s
      }
      _changes() {
        git log --since-as-filter="$1" --patch "$_ref" -- "$2" | _delta
      }
      _target_diff() {
        diff --report-identical-files "$_target/$1" "$1" 2>&1 | _delta
      }
      _target_update() {
        cp --interactive --verbose --no-dereference --force "$1" "$_target/$1" || read -p "Press ENTER to continue."
      }
      export -f _changes _delta _target_diff _target_update

      local -a _target_opt
      [ -z "$_target" ] || _target_opt=(--bind "alt-c:change-preview(_changes \"$1\" {})"
                                        --bind "alt-t:change-preview(_target_diff {})"
                                        --bind "alt-u:execute(_target_update {})+refresh-preview"
                                        --help "Alt-c:Changes since $1
                                                Alt-t:Diff to target version
                                                Alt-u:Update version in target"
                                       )

      _changed "$1" | \
      _fzf-wrapper --bind "enter:execute(_changes \"$1\" {})" \
                   --bind "focus:transform-preview-label(echo \"[ changes for {} ]\")" \
                   "${_target_opt[@]}" \
                   --border none \
                   --color "label:reverse" \
                   --exit-0 \
                   --list-label "[ Files changed since \"$1\" in \"$_ref\" history ]" \
                   --no-sort \
                   --preview "_changes \"$1\" {}" \
                   --preview-window "70%:wrap"
    fi

  else
    fn-usage "[--target worktree] since-date [ref]"
  fi
)

in-path tig || return 0

# /etc/tigrc is subject of package updates. Use $TIGRC_USER to enable site specific adaption.
export TIGRC_USER="$(myprofile --search etc/tigrc.user)"

new-alias tig TERM=xterm tig

git-files() {
  if [ $# -gt 0 ] ; then

    local _i
    local -a _files
    _files=("$@")
    for ((_i = 0 ; _i < $#; _i++ )) ; do
      [[ "${_files[$_i]}" =~ [\*/] ]] && continue
      _files[$_i]="*${_files[$_i]}*"
    done

    tig --all -- "${_files[@]}"

  else
    fn-usage "{(file|file-path|file-pattern]} .."
  fi
}

git-search() (
  if [ $# -gt 0 ] ; then
    local _all
    if [[ "$1" =~ ^-+a(ll)?$ ]] ; then
      _all="--all"
      shift
    fi

    if is-worktree ; then

      myprofile _fzf

      { echo "Commit|Date|Author|Subject"
        git log --pretty="%h|%ad|%an|%s" --date="format:%F %T" --regexp-ignore-case $_all -G "$@"
      } | column -t -s"|" -l 4 | \
      _fzf-wrapper --accept-nth 1 \
                   --bind "alt-g:change-preview(git grep --color=always --line-number --heading --full-name --ignore-case --context 2 --extended-regexp \"$@\" {1})" \
                   --bind "alt-l:execute(tig log {1})" \
                   --bind "alt-s:execute(tig show {1})" \
                   --bind "enter:accept" \
                   --border none \
                   --exit-0 \
                   --header-lines 1 \
                   --list-label " Commits adding or (re)moving case-insensitive regexp \"$@\" " \
                   --help "Alt-d:git diff;Alt-g:git grep;Alt-l:tig log;Alt-s:tig show" \
                   --preview-label " Git diff/grep output " \
                   --preview-init "alt-d:git diff --color=always --word-diff=color --abbrev {1}^ {1} -G \"$@\"" \
                   --preview-window "60%:wrap" \
                   --reverse
    fi

  else
    fn-usage "[--all] <regexp>"
  fi
)
complete -W "--all" git-search
